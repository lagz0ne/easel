{
  "name": "easel",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run db:generate && bun cmds/dev.ts",
    "db:generate": "bun scripts/db-generate.ts",
    "build": "rm -rf dist && bun run build:client && bun run build:server && bun run check:client && bun run check:tests",
    "build:client": "bun --bun vp build && bun scripts/embed-client.ts",
    "build:server": "bun scripts/build-binary.ts --outfile dist/server --sourcemap --metafile dist/meta.json",
    "check:client": "bun scripts/check-client.ts dist/client-meta.json",
    "check:tests": "bun scripts/check-no-tests.ts dist/client-meta.json dist/meta.json",
    "start": "dist/server",
    "typecheck": "bun scripts/embed-client.ts && bun --bun tsc --noEmit",
    "test": "bun --bun vp test",
    "check": "bun run typecheck && bun run test && bun run build",
    "check:style": "bun --bun vp check",
    "check:plain": "bun scripts/embed-client.ts && bun --bun tinker check",
    "smoke": "bash scripts/smoke.sh",
    "speed": "bun scripts/speed.ts",
    "design:proof": "bun scripts/design-proof.ts",
    "ship": "bash scripts/ship.sh",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@oxc-parser/binding-darwin-arm64": "0.159.0",
    "@oxc-parser/binding-linux-arm64-gnu": "0.159.0",
    "@oxc-parser/binding-linux-x64-gnu": "0.159.0",
    "@tanstack/react-router": "1.170.41",
    "@tinkered/bun": "^0.30.1",
    "@tinkered/core": "0.30.1",
    "@tinkered/react": "0.30.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-orm": "1.0.0-rc.4",
    "lightningcss": "1.33.0",
    "lightningcss-darwin-arm64": "1.33.0",
    "lightningcss-linux-arm64-gnu": "1.33.0",
    "lightningcss-linux-x64-gnu": "1.33.0",
    "lucide-react": "1.77.0",
    "oxc-parser": "0.159.0",
    "puppeteer-core": "^25.17.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.1",
    "tailwindcss": "4.3.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.14",
    "@tanstack/intent": "0.5.6",
    "@tinkered/cli": "^0.30.1",
    "@types/bun": "^1.3.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "5.1.1",
    "@vitest/browser-playwright": "5.0.1",
    "drizzle-kit": "1.0.0-rc.4",
    "playwright": "1.63.0",
    "typescript": "^7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.0.0",
    "vite-plus": "1.0.0"
  },
  "intent": {
    "skills": [
      "@tinkered/*"
    ]
  }
}
