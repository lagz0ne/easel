#!/bin/sh
# Trunk-based: main moves only through scripts/ship.sh, which gates the exact commit first.
# Emergency only (ship itself is broken): git push --no-verify, and say so in the commit message.
[ "${SHIP_GATED:-}" = 1 ] && exit 0
while read -r _ _ remote_ref _; do
  if [ "$remote_ref" = refs/heads/main ]; then
    echo "pre-push: main takes only gated commits. Use: scripts/ship.sh -m \"<msg>\" -- <paths>" >&2
    exit 1
  fi
done
exit 0
